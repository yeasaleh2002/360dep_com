# Copy this file to ".env" and fill in the values. Never put real values in this file.
# Full explanation of every variable: DEVELOPER_INSTRUCTIONS.md → "Environment variables".

# Database (Neon) — connection string from Neon → Connect
DATABASE_URL=""

# Admin login
JWT_SECRET=""            # random 64-char string:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""   # npm run hash-password -- "your-strong-password"

# Image hosting (free key: https://api.imgbb.com)
IMGBB_API_KEY=""

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=""        # country code + number, digits only, e.g. 8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_PROFILE_LINK=""  # optional, e.g. https://wa.me/qr/XXXXXXXX

# Analytics (Microsoft Clarity project id)
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Site
NEXT_PUBLIC_SITE_URL="https://360dep.com"

# Bot protection (Cloudflare Turnstile — free)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
