// Cloudflare Worker config. Secrets are never stored here — use `npx wrangler secret put NAME`.
// Setup: DEVELOPER_INSTRUCTIONS.md → "Deploy to Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "360dep-com",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

  // Required by OpenNext for background page rebuilds.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "360dep-com" }],

  // Page cache and cache tags. Ids are filled in automatically by `npm run deploy` (scripts/cf-deploy.mjs).
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV" }],

  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "dep360-tag-cache" }
  ],

  // Built-in rate limiting (free). Limits per visitor IP; must match lib/ratelimit.ts.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "3601", "simple": { "limit": 5, "period": 60 } },
    { "name": "CONTACT_LIMITER", "namespace_id": "3602", "simple": { "limit": 3, "period": 60 } }
  ],

  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://360dep.com"
  },

  "observability": { "enabled": true }
}
